#!/bin/sh
# git hook: nothing is pushed straight to main. Work goes to dev; a pull request dev -> main
# (VERSION raised) is the release, and the merge is the go-ahead for production (CLAUDE.md).
# Install once:  ln -sf ../../scripts/pre-push .git/hooks/pre-push
# The one deliberate exception (the user's call, never a habit):  git push --no-verify
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "pre-push: refusing to push $local_ref to ${remote_ref#refs/heads/}." >&2
      echo "  Push dev and open a pull request dev -> main (docs/RELEASING.md)." >&2
      exit 1 ;;
  esac
done
exit 0
