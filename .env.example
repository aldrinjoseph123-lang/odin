# Required. Generate with:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
# wsgi.py refuses to start if this is unset — a predictable signing key lets
# anyone forge a session cookie and log in as any user.
SECRET_KEY=

# Microsoft 365 (optional — mail, Teams, OneDrive backup).
# Can also be set in the app's Settings page instead; the database wins if both.
# The redirect URI registered in Azure must match this deployment's host exactly,
# scheme/host/port/path, or sign-in fails with AADSTS50011.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=

# Cloudflare Tunnel (only with docker-compose.cloudflare.yml). Token from
# Zero Trust → Networks → Tunnels → your tunnel. Never commit the real value.
CLOUDFLARE_TUNNEL_TOKEN=

# Behind Cloudflare Tunnel: makes every plain `docker compose …` command use
# both files, so nobody forgets the overlay (and publishes ports by mistake).
# cloudflared as a container (needs CLOUDFLARE_TUNNEL_TOKEN above):
# COMPOSE_FILE=docker-compose.yml:docker-compose.cloudflare.yml
# cloudflared installed on the host as a service (route → http://localhost:8080):
# COMPOSE_FILE=docker-compose.yml:docker-compose.host-tunnel.yml
