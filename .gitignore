# --- state: lives in ODIN_DATA_DIR / the Docker volume, never in git ---
odin.db
odin.db-*
*.bak
uploads/
backups/
avatars/
brand/
uat-data/
*.log

# --- secrets ---
.env
deploy/certs/*
!deploy/certs/.gitkeep

# --- frontend ---
frontend/node_modules/
frontend/dist/

# --- python ---
venv/
__pycache__/
*.pyc

# --- local tooling / OS ---
.claude/settings.local.json
# Impeccable: design record and evidence are tracked; caches, roll payloads and profiles are not
.impeccable/hook.cache.json
.impeccable/*payload*.json
.impeccable/live/
.DS_Store

# --- stray tool caches at the root ---
node_modules/
.claude/worktrees/

# dev/UAT signing key generated by core.py when SECRET_KEY is unset
secret_key
