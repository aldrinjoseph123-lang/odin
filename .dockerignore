# The image carries code only. Secrets and state live in .env and the
# odin-data volume — never baked into a layer anyone with the image can read.

# secrets
.env
.env.*
deploy/certs/
secret_key

# state (dev copies; production state is the volume)
*.db
*.db-*
*.db.*.bak
*.bak
uploads/
backups/
avatars/
brand/
audit-archive/
uat-data*/
*.log

# tooling and dependencies rebuilt in the image
venv/
__pycache__/
*.pyc
node_modules/
frontend/node_modules
frontend/dist
frontend/test-results
frontend/playwright-report
.git/
.github/
.claude/
.impeccable/
.DS_Store

# tests and their fixtures: they run in CI, not in the image
test_*.py
tests/
frontend/e2e/*-snapshots
frontend/src/**/*.test.ts
frontend/src/**/*.test.tsx
frontend/src/lib/__contract__
# (frontend/e2e/*.ts stays in the build context: `tsc -b` in the Node stage type-checks it)

# docs: the app serves only the System Map (routes/settings.py, /settings/map/page)
docs/*
!docs/system-map.html
